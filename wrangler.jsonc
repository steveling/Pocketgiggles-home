// Cloudflare Worker that serves the Pocket Giggles homepage at https://pocketgiggles.com.
// Static files only, served straight from the repo root; .assetsignore keeps the rest private.
{
  "name": "pocketgiggles-home",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "." },
  "previews": {}
}
